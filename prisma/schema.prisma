// Esper – Prisma schema
// Money values are stored as DECIMAL(14,2). Never use JS floats for money.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Who financially owns the money. Not a login user.
enum Owner {
  SELF
  BROTHER
}

enum AccountType {
  CASH
  BANK
  UPI
  CARD
  TRADING
  INVESTMENT
  OTHER
}

enum CategoryType {
  EXPENSE
  INCOME
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
  TRADING_DEPOSIT
  TRADING_WITHDRAWAL
  TRADING_PROFIT
  TRADING_LOSS
  BORROW
  LEND
  LOAN_REPAYMENT
  LENT_REPAYMENT
}

enum PaymentMode {
  CASH
  UPI
  BANK
  CARD
  TRANSFER
  OTHER
}

enum LoanDirection {
  BORROWED
  LENT
}

enum LoanStatus {
  ACTIVE
  PAID
}

/// What a recurring plan represents. Drives the transaction produced when an instalment
/// is paid: SIP moves money into an investment account (a TRANSFER), everything else
/// leaves an account for good (an EXPENSE).
enum PlanKind {
  FEE
  SUBSCRIPTION
  BILL
  EMI
  SIP
  OTHER
}

enum PlanFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  ONE_TIME
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PAID
  SKIPPED
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  /// Incremented on password change to invalidate existing sessions.
  sessionVersion Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  people       Person[]
  loans        Loan[]
  plans        Plan[]
  installments Installment[]
  valuations   Valuation[]
}

model Account {
  id             String      @id @default(cuid())
  userId         String
  name           String
  type           AccountType
  owner          Owner       @default(SELF)
  openingBalance Decimal     @default(0) @db.Decimal(14, 2)
  isActive       Boolean     @default(true)
  sortOrder      Int         @default(0)
  /// Bank / card issuer / fund house. Display only.
  institution    String?
  /// Last 4 digits, so two cards can be told apart. Never store a full card number.
  last4          String?
  /// CARD only: sanctioned limit. Outstanding, utilisation and "available to spend" are
  /// all derived from it plus the (negative) balance.
  creditLimit    Decimal?    @db.Decimal(14, 2)
  /// CARD only: day of month the statement is generated (1-31).
  statementDay   Int?
  /// CARD only: day of month the bill is due (1-31).
  dueDay         Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  outgoing   Transaction[] @relation("FromAccount")
  incoming   Transaction[] @relation("ToAccount")
  planSource Plan[]        @relation("PlanFromAccount")
  planTarget Plan[]        @relation("PlanToAccount")
  valuations Valuation[]

  @@index([userId])
  @@index([userId, owner])
  @@index([userId, type])
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  name      String
  type      CategoryType
  icon      String?
  color     String?
  isActive  Boolean      @default(true)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  plans        Plan[]

  @@unique([userId, type, name])
  @@index([userId])
}

model Person {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  loans Loan[]

  @@index([userId])
}

model Loan {
  id                String        @id @default(cuid())
  userId            String
  personId          String
  direction         LoanDirection
  originalAmount    Decimal       @db.Decimal(14, 2)
  /// Derived: originalAmount - sum(repayments). Recomputed inside the same DB transaction
  /// whenever a linked transaction changes.
  outstandingAmount Decimal       @db.Decimal(14, 2)
  status            LoanStatus    @default(ACTIVE)
  notes             String?
  startDate         DateTime      @db.Date
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  person       Person        @relation(fields: [personId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([userId, status])
  @@index([personId])
}

model Transaction {
  id              String          @id @default(cuid())
  userId          String
  type            TransactionType
  amount          Decimal         @db.Decimal(14, 2)
  categoryId      String?
  owner           Owner           @default(SELF)
  /// Money leaves this account (EXPENSE, TRANSFER, TRADING_DEPOSIT/WITHDRAWAL, TRADING_LOSS, LEND, LOAN_REPAYMENT)
  fromAccountId   String?
  /// Money enters this account (INCOME, TRANSFER, TRADING_DEPOSIT/WITHDRAWAL, TRADING_PROFIT, BORROW, LENT_REPAYMENT)
  toAccountId     String?
  paymentMode     PaymentMode     @default(OTHER)
  notes           String?
  transactionDate DateTime        @db.Date
  /// Set for BORROW, LEND, LOAN_REPAYMENT, LENT_REPAYMENT
  loanId          String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  fromAccount Account?  @relation("FromAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   Account?  @relation("ToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  loan        Loan?     @relation(fields: [loanId], references: [id], onDelete: Restrict)
  /// Set when this transaction was created by paying a plan instalment.
  installment Installment?

  @@index([userId, transactionDate(sort: Desc), createdAt(sort: Desc)])
  @@index([userId, type])
  @@index([userId, owner])
  @@index([userId, paymentMode])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([categoryId])
  @@index([loanId])
}

/// A recurring obligation: course fees, a subscription, a utility bill, an EMI or a SIP.
///
/// A plan is a template plus a generated schedule of Installments. Nothing touches the
/// ledger until an instalment is marked paid, which creates a real Transaction — so past
/// years can be entered in one go and every balance still comes out right.
model Plan {
  id            String        @id @default(cuid())
  userId        String
  kind          PlanKind
  name          String
  /// School, university, card issuer, fund house, service.
  provider      String?
  /// Amount of a single instalment.
  amount        Decimal       @db.Decimal(14, 2)
  frequency     PlanFrequency
  startDate     DateTime      @db.Date
  /// Null for open-ended plans (a subscription that has not been cancelled).
  endDate       DateTime?     @db.Date
  /// Number of instalments when known (8 semesters, 24 EMIs). Null = open-ended.
  totalCount    Int?
  owner         Owner         @default(SELF)
  paymentMode   PaymentMode   @default(OTHER)
  /// Required for every kind except SIP, which moves money rather than spending it.
  categoryId    String?
  /// Account the money leaves.
  fromAccountId String?
  /// SIP only: the investment account the money lands in.
  toAccountId   String?
  /// Days before the due date that an instalment starts showing as "due soon".
  remindDays    Int           @default(3)
  status        PlanStatus    @default(ACTIVE)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  fromAccount  Account?      @relation("PlanFromAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount    Account?      @relation("PlanToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  installments Installment[]

  @@index([userId, status])
  @@index([userId, kind])
}

/// One dated amount within a plan. Paying it creates the Transaction it points at.
model Installment {
  id            String            @id @default(cuid())
  userId        String
  planId        String
  /// 1-based position in the plan, so it can read "Semester 3 of 8".
  sequence      Int
  /// Overrides the generated label ("Semester 3", "Mar 2026").
  label         String?
  dueDate       DateTime          @db.Date
  amount        Decimal           @db.Decimal(14, 2)
  status        InstallmentStatus @default(PENDING)
  paidDate      DateTime?         @db.Date
  transactionId String?           @unique
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([planId, sequence])
  @@index([userId, status, dueDate])
  @@index([planId, dueDate])
}

/// A dated "what is it worth now" snapshot for an investment account.
///
/// The account balance already tracks what went in; this records market value, so the
/// gain is simply value - balance. No price feed, no background jobs.
model Valuation {
  id        String   @id @default(cuid())
  userId    String
  accountId String
  asOf      DateTime @db.Date
  value     Decimal  @db.Decimal(14, 2)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, asOf])
  @@index([userId, accountId, asOf(sort: Desc)])
}
