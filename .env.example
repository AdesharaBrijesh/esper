# ---------------------------------------------------------------------------
# Leno Expenses – environment configuration
# Copy this file to .env and change every CHANGE_ME value.
# Never commit .env.
# ---------------------------------------------------------------------------

# Application
NODE_ENV=production
# Timezone used for "today" and month boundaries
TZ=Asia/Kolkata
# Host port the app is published on (docker-compose maps APP_PORT -> 3000)
APP_PORT=3000
PORT=3000

# Database (used by the postgres container AND to build DATABASE_URL)
POSTGRES_USER=expense
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=expense_tracker

# Inside Docker Compose the host is the service name "postgres".
# If POSTGRES_PASSWORD contains special characters (@ : / ? # %) URL-encode them here
# (e.g. "@" -> "%40").
DATABASE_URL=postgresql://expense:CHANGE_ME@postgres:5432/expense_tracker

# Authentication – long random string, e.g. `openssl rand -base64 48`
AUTH_SECRET=CHANGE_ME
# Session cookies are marked Secure in production. Set to false ONLY if you open the
# app over plain http:// on your LAN without HTTPS (otherwise login will not stick).
# COOKIE_SECURE=false

# Initial user (created by the seed on first start if no user exists; never overwritten)
SEED_USER_NAME=Me
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=CHANGE_ME
# Create clearly named example accounts with a zero opening balance on first start
SEED_EXAMPLE_ACCOUNTS=true

# Branding (optional)
NEXT_PUBLIC_APP_NAME=Leno Expenses
NEXT_PUBLIC_THEME_COLOR=#0f766e
